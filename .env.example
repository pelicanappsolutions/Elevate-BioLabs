# ─────────────────────────────────────────────────────────────
#  ELEVATE BIO-LABS — Environment Variables
#  Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ---- Core ----
# Neon / Supabase pooled connection string
DATABASE_URL="postgresql://user:password@host:5432/elevate?schema=public"
# Direct (non-pooled) connection for migrations (Neon/Supabase)
DIRECT_URL="postgresql://user:password@host:5432/elevate?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate: `openssl rand -base64 32`
AUTH_SECRET="replace-with-32-byte-random-string"
NEXTAUTH_SECRET="replace-with-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- Vercel Cron ----
# Required in production so /api/cron/* accept Vercel Cron invocations.
# Generate: `openssl rand -base64 32` — set the same value in the Vercel project
# env. Vercel sends it as Authorization: Bearer $CRON_SECRET.
CRON_SECRET="replace-with-32-byte-random-string"

# OAuth (optional — Google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Feature flags / compliance ----
AGE_GATE_ENABLED="true"
MIN_AGE="18"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Payment: NexaPay (primary card, crypto settlement backend) ----
# When keys are absent the adapter runs in MOCK mode.
NEXAPAY_API_KEY=""
NEXAPAY_SECRET=""
NEXAPAY_WEBHOOK_SECRET=""
NEXAPAY_BASE_URL="https://api.nexapay.example/v1"

# ---- Payment: SeamlessChex / AllayPay (ACH / eCheck) ----
SEAMLESSCHEX_API_KEY=""
SEAMLESSCHEX_WEBHOOK_SECRET=""
SEAMLESSCHEX_BASE_URL="https://api.seamlesschex.com/v1"

# ---- Payment: PayRam (smart routing fallback) ----
PAYRAM_API_KEY=""
PAYRAM_WEBHOOK_SECRET=""
PAYRAM_BASE_URL="https://api.payram.example/v1"

# ---- Payment: Stripe (fallback / load-balancing) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Payment: Coinbase Commerce (crypto direct) ----
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# ---- Payment: NOWPayments (crypto direct: BTC, ETH, altcoins) ----
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_WEBHOOK_SECRET=""
# Use sandbox for testing: https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_BASE_URL="https://api.nowpayments.io/v1"

# ---- P2P manual rails (display strings shown at checkout) ----
P2P_ZELLE_HANDLE="trosclair.danny@gmail.com"
P2P_VENMO_HANDLE="@elevateresearch"
P2P_WIRE_INSTRUCTIONS="Contact info@elevatebiolab.com for wire details"

# ---- P2P email notification polling (Venmo/Zelle inbound alerts) ----
# IMAP credentials for the mailbox that receives payment notifications.
# Use an app-specific password, not the account password.
P2P_EMAIL_IMAP_HOST="imap.gmail.com"
P2P_EMAIL_IMAP_PORT="993"
P2P_EMAIL_IMAP_USER="elevatebiolab@example.com"
P2P_EMAIL_IMAP_PASSWORD=""
P2P_EMAIL_POLL_FOLDER="INBOX"
P2P_EMAIL_LOOKBACK_HOURS="24"
P2P_EMAIL_MAX_PER_RUN="50"

# ---- Shipping: Shippo (preferred label provider) ----
# Test keys start with shippo_test_; live keys start with shippo_live_.
SHIPPO_API_KEY=""

# ---- Shipping: USPS (optional direct integration) ----
USPS_API_KEY=""
USPS_CLIENT_ID=""
USPS_CLIENT_SECRET=""
USPS_BASE_URL="https://apis.usps.com"
# Compliance: return address should be "[Business Name] Chemical Supply" or
# "Analytical Standards Division" — never a clinical/medical brand name.
SHIP_FROM_NAME="C&D RESEARCH LLC"
SHIP_FROM_STREET="110 Tall Pines St"
SHIP_FROM_CITY="Belle Chasse"
SHIP_FROM_STATE="LA"
SHIP_FROM_ZIP="70037"

# ---- Email: SendGrid (transactional + marketing) ----
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="info@elevatebiolab.com"
SENDGRID_FROM_NAME="Elevate Bio-Labs"
CONTACT_EMAIL="info@elevatebiolab.com"
# Optional: pre-created SendGrid Unsubscribe Group ID (ASM). If empty, the app
# creates/finds a "Marketing" group via the SendGrid API when sending promos.
SENDGRID_ASM_GROUP_ID=""

# ---- Email: Klaviyo (marketing flows) ----
KLAVIYO_API_KEY=""
KLAVIYO_PUBLIC_KEY=""
KLAVIYO_LIST_ID=""

# ---- File storage: Vercel Blob (or S3) ----
# Vercel Blob supports either a legacy token or a store ID. Set one or the other.
BLOB_READ_WRITE_TOKEN=""
BLOB_READ_WRITE_TOKEN_STORE_ID=""
# Optional S3 fallback
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
