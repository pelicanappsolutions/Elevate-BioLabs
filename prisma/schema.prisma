// ─────────────────────────────────────────────────────────────
//  Elevate Bio-Labs — Prisma schema
//  PostgreSQL (Neon / Supabase). Optimistic locking on Product.version.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================ ENUMS ============================

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductForm {
  LYOPHILIZED
  SOLUTION
  CAPSULE
  BLEND
  NASAL_SPRAY
}

enum OrderStatus {
  PENDING_PAYMENT // created, awaiting payment
  AWAITING_REVIEW // P2P proof uploaded, admin must verify
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentRail {
  NEXAPAY // primary card
  SEAMLESSCHEX // ACH / eCheck
  PAYRAM // smart-routing fallback
  STRIPE // fallback card
  COINBASE // crypto direct
  P2P_ZELLE
  P2P_VENMO
  P2P_WIRE
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  MANUAL_REVIEW
}

enum InventoryReason {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  RESERVATION_RELEASE
}

enum CampaignType {
  WELCOME
  ABANDONED_CART_24H
  ABANDONED_CART_48H
  ORDER_CONFIRMATION
  SHIPMENT_TRACKING
  POST_PURCHASE_REVIEW
  PROMOTIONAL
}

// ============================ AUTH ============================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(CUSTOMER)
  ageVerified   Boolean   @default(false)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  savedProducts SavedProduct[]
  dosageLogs    DosageLog[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String? // "Home", "Lab", ...
  fullName  String
  street1   String
  street2   String?
  city      String
  state     String
  zip       String
  country   String  @default("US")
  phone     String?
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================ CATALOG ============================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  sku         String      @unique
  name        String
  slug        String      @unique
  description String      @db.Text
  cas         String? // CAS registry number
  purity      String? // e.g. ">=99%"
  molarMass   Float?
  sequence    String? // amino-acid sequence
  form        ProductForm @default(LYOPHILIZED)
  storageInfo String?     @db.Text
  researchUse Boolean     @default(true) // RUO flag

  priceCents Int // base unit price
  compareAtCents Int? // strike-through price
  currency   String @default("USD")

  // Inventory + OPTIMISTIC LOCKING
  stock     Int @default(0)
  reserved  Int @default(0) // held during checkout
  lowStockThreshold Int @default(10)
  version   Int @default(0) // bumped on every stock mutation

  active     Boolean @default(true)
  featured   Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images       ProductImage[]
  priceTiers   PriceTier[]
  coas         COA[]
  orderItems   OrderItem[]
  inventoryLogs InventoryLog[]
  savedBy      SavedProduct[]
  dosageLogs   DosageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([active, featured])
  @@index([slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Bulk pricing: buy >= minQty, pay unitPriceCents
model PriceTier {
  id            String  @id @default(cuid())
  productId     String
  minQty        Int
  unitPriceCents Int
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
}

// Certificate of Analysis PDF
model COA {
  id        String   @id @default(cuid())
  productId String
  batchLot  String
  fileUrl   String
  testedOn  DateTime?
  purity    String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([batchLot])
}

// ============================ ORDERS ============================

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique // human-friendly EBL-XXXXXX
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  guestEmail   String?
  status       OrderStatus @default(PENDING_PAYMENT)

  addressId    String?
  address      Address?    @relation(fields: [addressId], references: [id])
  // frozen snapshot of shipping address at purchase time
  shipTo       Json?

  subtotalCents Int
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  discountCents Int    @default(0)
  totalCents    Int
  currency      String @default("USD")

  // shipping
  shipService   String? // e.g. "USPS_PRIORITY"
  trackingNumber String?
  labelUrl       String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items          OrderItem[]
  payments       Payment[]
  receipts       PaymentReceipt[]
  campaignEvents CampaignEvent[]

  notes     String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  // frozen snapshot at purchase
  name       String
  sku        String
  quantity   Int
  unitPriceCents Int
  totalCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  rail          PaymentRail
  status        PaymentStatus @default(INITIATED)
  amountCents   Int
  currency      String        @default("USD")
  providerRef   String? // gateway charge/session id
  providerRaw   Json? // raw gateway payload
  feeCents      Int?
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([providerRef])
  @@index([status])
}

// P2P proof-of-payment upload (Zelle/Venmo/Wire) awaiting admin approval
model PaymentReceipt {
  id          String   @id @default(cuid())
  orderId     String
  rail        PaymentRail
  fileUrl     String
  reference   String? // sender note / confirmation #
  amountCents Int?
  approved    Boolean  @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([approved])
}

// ============================ INVENTORY ============================

model InventoryLog {
  id        String          @id @default(cuid())
  productId String
  reason    InventoryReason
  delta     Int // +restock / -sale
  before    Int
  after     Int
  orderId   String?
  note      String?
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ============================ CUSTOMER TOOLS ============================

model SavedProduct {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model DosageLog {
  id         String   @id @default(cuid())
  userId     String
  productId  String?
  dateTaken  DateTime @default(now())
  doseMcg    Float
  volumeMl   Float?
  note       String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])

  @@index([userId])
}

// ============================ COMPLIANCE / OPS ============================

model AuditLog {
  id       String  @id @default(cuid())
  userId   String?
  action   String // "ORDER_STATUS_CHANGE", "RECEIPT_APPROVED", ...
  entity   String? // "Order", "Product"
  entityId String?
  meta     Json?
  ip       String?
  user     User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model CampaignEvent {
  id        String       @id @default(cuid())
  type      CampaignType
  email     String
  orderId   String?
  provider  String       @default("klaviyo") // klaviyo | sendgrid
  status    String       @default("queued") // queued | sent | failed
  meta      Json?
  order     Order?       @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([type])
  @@index([email])
}

model ComplianceDoc {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  category String // "RUO", "SHIPPING_POLICY", "LEGITSCRIPT", "REFUND", ...
  body     String  @db.Text
  fileUrl  String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tracks VAMP / chargeback thresholds for LegitScript readiness
model ChargebackMetric {
  id            String   @id @default(cuid())
  periodStart   DateTime
  periodEnd     DateTime
  rail          PaymentRail
  txnCount      Int      @default(0)
  chargebacks   Int      @default(0)
  ratio         Float    @default(0) // chargebacks / txnCount
  thresholdPct  Float    @default(1.5) // Visa VAMP 2026
  breached      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([rail])
  @@index([periodStart])
}
